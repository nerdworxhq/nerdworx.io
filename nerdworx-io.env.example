# Production env for nerdworx.io. Copy to nerdworx-io.env (gitignored),
# fill in the blanks, then load it into the nerdworx-io-env-configmap (see DEPLOY.md).
APP_NAME="Nerdworx"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nerdworx.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=nerdworx-postgres-1-rw.cnpg-system.svc.cluster.local
DB_PORT=5432
DB_DATABASE=nerdworx_io
DB_USERNAME=nerdworx_io
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@nerdworx.com"
MAIL_FROM_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=https://account.nerdworx.com
ONBOARDING_NOTIFY_EMAIL=
